---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostalExplorer from '@/components/PostalExplorer.astro';
import { getUi } from '@/i18n/ui';

const lang = 'uk';
const t = getUi(lang);
const base = import.meta.env.BASE_URL;
---

<BaseLayout lang={lang} title={t.nav.postal} description={t.postal.lead}>
  <h1>{t.postal.title}</h1>
  <PostalExplorer lang={lang} base={base} />
</BaseLayout>
