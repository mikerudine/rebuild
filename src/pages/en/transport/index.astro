---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TransportExplorer from '@/components/TransportExplorer.astro';
import { getUi } from '@/i18n/ui';

const lang = 'en';
const t = getUi(lang);
const base = import.meta.env.BASE_URL;
---

<BaseLayout lang={lang} title={t.nav.transport} description={t.transport.lead}>
  <h1>{t.transport.title}</h1>
  <TransportExplorer lang={lang} base={base} />
</BaseLayout>
