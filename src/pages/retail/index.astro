---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RetailExplorer from '@/components/RetailExplorer.astro';
import { getUi } from '@/i18n/ui';

const lang = 'uk';
const t = getUi(lang);
const base = import.meta.env.BASE_URL;
---

<BaseLayout lang={lang} title={t.nav.retail} description={t.retail.lead}>
  <h1>{t.retail.title}</h1>
  <RetailExplorer lang={lang} base={base} />
</BaseLayout>
