---
interface Props { lang: 'uk' | 'en'; base: string; slug: string }
const { lang, base, slug } = Astro.props;
const T = {
  uk: {
    kick: 'Регіональний профіль', h1: ['Івано-', 'Франківщина ', 'росте', 'не всюди однаково'],
    bub: 'Громади: бізнес × освіта', bubN: 'X — зміна кількості юросіб 2021→2025, Y — зміна кількості випускників на НМТ 2023→2025. Розмір — кількість ФОП, колір — район. Пунктири — Україна.',
    rad: 'Область проти України', radN: 'Зміна показника від базового року, %', obl: 'область', ua: 'Україна',
    his: 'Як розподілені громади за ростом ФОП', hisN: 'Кількість громад за зміною кількості ФОП, 2021→2025',
    wf: 'Автобусні маршрути: куди поділися', wfN: 'Маршрути 2019 → відкриті мінус закриті за рік → 2026 (порівняння знімків реєстрів Укртрансбезпеки)',
    dn: 'Що будують', dnN: 'Введені житлові будинки, січень–вересень. Внутрішнє кільце — 2021, зовнішнє — 2026 (ЄДЕССБ)', dnL: ['нові будинки', 'узаконені', 'багатоквартирні'],
    db: 'До і після по громадах', tabs: ['Школи 2023→2025', 'Рейси 2019→2026'], dbL: ['було', 'стало більше', 'стало менше'],
    src: 'Джерела: Держстат, ЄДЕССБ, УЦОЯО (НМТ), Укртрансбезпека, work.ua, OSM/АТБ.', meth: 'Методологія',
  },
  en: {
    kick: 'Regional profile', h1: ['Ivano-', 'Frankivsk oblast ', 'grows', 'but not evenly'],
    bub: 'Hromadas: business × education', bubN: 'X — change in legal entities 2021→2025, Y — change in NMT graduates 2023→2025. Size — number of FOPs, colour — raion. Dashed lines — Ukraine.',
    rad: 'Oblast vs Ukraine', radN: 'Change since base year, %', obl: 'oblast', ua: 'Ukraine',
    his: 'How hromadas spread by FOP growth', hisN: 'Number of hromadas by change in sole proprietors (FOP), 2021→2025',
    wf: 'Bus routes: where did they go', wfN: 'Routes in 2019 → opened minus closed per year → 2026 (Ukrtransbezpeka register snapshots)',
    dn: 'What gets built', dnN: 'Residential buildings commissioned, Jan–Sep. Inner ring — 2021, outer — 2026 (EDESSB)', dnL: ['new houses', 'legalised', 'apartment blocks'],
    db: 'Before and after by hromada', tabs: ['Schools 2023→2025', 'Trips 2019→2026'], dbL: ['before', 'increased', 'decreased'],
    src: 'Sources: Derzhstat, EDESSB, UCEQA (NMT), Ukrtransbezpeka, work.ua, OSM/ATB.', meth: 'Methodology',
  },
}[lang];
const mpath = lang === 'uk' ? `${base}methodology/` : `${base}en/methodology/`;
---
<div class="od" id="pd" data-base={base} data-lang={lang} data-slug={slug}>
<div class="w">
  <div class="hd"><div><div class="k">{T.kick} · <span id="asof"></span></div><h1>{T.h1[0]}<br/>{T.h1[1]}<em>{T.h1[2]}</em><br/>{T.h1[3]}</h1></div><div class="hs" id="hs"></div></div>
  <div class="g">
    <div class="c s8"><h3>{T.bub}</h3><div class="n">{T.bubN}</div><div class="ch" id="bub"></div><div class="lg" id="bubl"></div></div>
    <div class="c s4"><h3>{T.rad}</h3><div class="n">{T.radN}</div><div class="ch" id="rad"></div><div class="lg"><span><i style="background:var(--a)"></i>{T.obl}</span><span><i style="background:var(--b)"></i>{T.ua}</span></div></div>
    <div class="c s6"><h3>{T.his}</h3><div class="n">{T.hisN}</div><div class="ch" id="his"></div></div>
    <div class="c s6"><h3>{T.wf} <span id="wfn"></span></h3><div class="n">{T.wfN}</div><div class="ch" id="wf"></div></div>
    <div class="c s4"><h3>{T.dn}</h3><div class="n">{T.dnN}</div><div class="ch" id="dn"></div><div class="lg"><span><i style="background:var(--a)"></i>{T.dnL[0]}</span><span><i style="background:var(--u)"></i>{T.dnL[1]}</span><span><i style="background:var(--p)"></i>{T.dnL[2]}</span></div></div>
    <div class="c s8"><h3>{T.db}</h3><div class="tabs"><button data-m="schools" aria-pressed="true">{T.tabs[0]}</button><button data-m="trips" aria-pressed="false">{T.tabs[1]}</button></div><div class="n" id="dbn"></div><div class="ch" id="db"></div><div class="lg"><span><i style="background:#8e8ea6"></i>{T.dbL[0]}</span><span><i style="background:var(--a)"></i>{T.dbL[1]}</span><span><i style="background:var(--p)"></i>{T.dbL[2]}</span></div></div>
  </div>
  <p class="src">{T.src} <a href={mpath}>{T.meth}</a></p>
</div>
</div>
<style is:global>
.od{--bg:#0a0a12;--c:#13131f;--ln:#262636;--tx:#f4f4f7;--mu:#8e8ea6;--a:#c6f432;--b:#7c5cff;--p:#ff4d8d;--u:#59d6ff;background:radial-gradient(1200px 600px at 85% -10%,#2a1d6b55,transparent),var(--bg);color:var(--tx);font:14px/1.45 Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.od *{box-sizing:border-box}
.od .w{max-width:1360px;margin:0 auto;padding:36px 36px 48px}
.od .k{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--a);font-weight:700}
.od h1{font-size:76px;line-height:.95;letter-spacing:-.045em;margin:12px 0 0;font-weight:800;color:var(--tx)}
.od h1 em{font-style:normal;background:linear-gradient(90deg,var(--a),var(--u));-webkit-background-clip:text;background-clip:text;color:transparent}
.od .hd{display:grid;grid-template-columns:1.4fr 1fr;gap:30px;align-items:end;margin-bottom:28px}
.od .hs{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.od .hs div{border:1px solid var(--ln);border-radius:16px;padding:14px 16px;background:#ffffff06}
.od .hs b{display:block;font-size:34px;letter-spacing:-.03em;font-weight:800}.od .hs span{color:var(--mu);font-size:12px}
.od .g{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}
.od .c{background:var(--c);border:1px solid var(--ln);border-radius:20px;padding:20px 22px;min-width:0}
.od .c h3{margin:0;font-size:18px;color:var(--tx)}.od .c .n{color:var(--mu);font-size:12px;margin:4px 0 12px}
.od .s8{grid-column:span 8}.od .s6{grid-column:span 6}.od .s4{grid-column:span 4}
.od .ch svg{max-width:100%;height:auto;overflow:visible}
.od .lg{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:11px;color:var(--mu);margin-top:8px}.od .lg i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;vertical-align:-1px}
.od .tabs{display:flex;gap:6px;margin:-4px 0 10px;flex-wrap:wrap}.od .tabs button{background:#ffffff0a;border:1px solid var(--ln);color:var(--mu);border-radius:99px;padding:4px 12px;font:inherit;font-size:12px;cursor:pointer}.od .tabs button[aria-pressed=true]{background:var(--a);color:#0a0a12;border-color:var(--a)}
.od .src{color:var(--mu);font-size:11px;margin:26px 0 0}.od .src a{color:var(--u)}
@media(max-width:760px){.od .w{padding:20px 14px 32px}.od h1{font-size:44px}.od .hd{grid-template-columns:1fr;gap:18px}.od .g{grid-template-columns:1fr}.od .g>*{grid-column:auto}.od .hs b{font-size:26px}.od .c{padding:16px 14px}}
</style>
<script>
  import { initOblastDashboardD } from '@/lib/oblast-dashboard-d-client';
  initOblastDashboardD();
</script>
