---
import type { Lang } from '@/i18n/ui';
import { getUi } from '@/i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  chartId: string;
  dataUrl: string;
  sourceLabel: string;
  sourceUrl: string;
  fetchedAt: string;
  note?: string;
}

const { lang, title, chartId, dataUrl, sourceLabel, sourceUrl, fetchedAt, note } = Astro.props;
const t = getUi(lang);
const base = import.meta.env.BASE_URL;
---

<figure class="chart-block">
  <h3>{title}</h3>
  {note && <p class="lead" style="font-size: 0.9rem; margin-bottom: 0.75rem;">{note}</p>}
  <div id={chartId} class="plot-target" data-chart-url={dataUrl} data-chart-id={chartId}></div>
  <figcaption class="chart-meta">
    <p>
      <strong>{t.chart.source}:</strong>{' '}
      <a href={sourceUrl} rel="noopener noreferrer">{sourceLabel}</a>
    </p>
    <p><strong>{t.chart.fetched}:</strong> {fetchedAt}</p>
    <p>
      <strong>{t.chart.data}:</strong>{' '}
      <a href={dataUrl} download>{dataUrl.split('/').pop()}</a>
    </p>
  </figcaption>
</figure>

<script>
  import { initChartFigures } from '@/lib/chart-figure-client';
  initChartFigures();
</script>
