---
import type { Lang } from '@/i18n/ui';
import { workuaCityLabels, WORKUA_STAT_URL } from '@/data/workua-cities';

interface Props {
  lang: Lang;
  dataUrl: string;
}

const { lang, dataUrl } = Astro.props;
---

<div class="jobs-explorer" data-lang={lang} data-url={dataUrl}>
  <p class="lead">
    {lang === 'uk'
      ? 'Місячні медіанні зарплати в оголошеннях та кількість вакансій на work.ua по містах (жовтень 2023 — жовтень 2026). Джерело агрегатів — '
      : 'Monthly median advertised salaries and vacancy counts on work.ua by city (October 2023 – October 2026). Aggregates from '}
    <a href={WORKUA_STAT_URL} rel="noopener noreferrer">work.ua/stat</a>.
  </p>

  <label class="city-picker">
    {lang === 'uk' ? 'Місто:' : 'City:'}
    <select id="jobs-city-select"></select>
  </label>

  <div class="chart-block">
    <h3>{lang === 'uk' ? 'Медіанна зарплата в оголошеннях, грн' : 'Median advertised salary, UAH'}</h3>
    <div id="jobs-salary-chart" class="plot-target"></div>
  </div>
  <div class="chart-block">
    <h3>{lang === 'uk' ? 'Кількість вакансій' : 'Vacancy count'}</h3>
    <div id="jobs-count-chart" class="plot-target"></div>
  </div>
  <div class="chart-block">
    <h3>{lang === 'uk' ? 'Зміна за 3 роки (жов 2023 → жов 2026)' : 'Three-year change (Oct 2023 → Oct 2026)'}</h3>
    <div id="jobs-change-chart" class="plot-target"></div>
    <p class="chart-meta" id="jobs-change-caption"></p>
  </div>

  <p class="chart-meta">
    {lang === 'uk' ? 'Дані:' : 'Data:'}{' '}
    <a href={dataUrl} download>workua_city_monthly.csv</a>
  </p>
</div>

<script>
  import { initJobsExplorer } from '@/lib/jobs-explorer-client';
  initJobsExplorer();
</script>

<style>
  .city-picker {
    display: block;
    margin: 1rem 0 1.5rem;
    font-size: 0.95rem;
  }
  .city-picker select {
    margin-left: 0.5rem;
    padding: 0.35rem 0.5rem;
    min-width: 12rem;
  }
</style>
