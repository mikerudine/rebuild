---
import '@/styles/global.css';
import type { Lang } from '@/i18n/ui';
import { getUi } from '@/i18n/ui';
import { localizedPath, switchLangPath } from '@/i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = getUi(lang);
const otherLang = lang === 'uk' ? 'en' : 'uk';
const pageTitle = `${title} · ${t.siteName}`;
const desc = description ?? t.siteTagline;
const base = import.meta.env.BASE_URL;

function navCurrent(pathSegment: string, pathname: string): 'page' | undefined {
  const seg = pathSegment.replace(/\/$/, '');
  if (seg === '' || seg === '/') {
    const inner = ['cases', 'growth', 'jobs', 'retail', 'horeca', 'data', 'methodology'];
    if (inner.some((s) => pathname.includes(`/${s}`))) return undefined;
    return pathname.includes('/rebuild') ? 'page' : undefined;
  }
  return pathname.includes(seg) ? 'page' : undefined;
}

const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={localizedPath('/', lang)}>
          {t.siteName}
          <span>{t.siteTagline}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href={localizedPath('/', lang)} aria-current={navCurrent('/', path)}>{t.nav.home}</a>
          <a href={localizedPath('/cases/', lang)} aria-current={navCurrent('/cases', path)}>{t.nav.cases}</a>
          <a href={localizedPath('/growth/', lang)} aria-current={navCurrent('/growth', path)}>{t.nav.growth}</a>
          <a href={localizedPath('/jobs/', lang)} aria-current={navCurrent('/jobs', path)}>{t.nav.jobs}</a>
          <a href={localizedPath('/retail/', lang)} aria-current={navCurrent('/retail', path)}>{t.nav.retail}</a>
          <a href={localizedPath('/horeca/', lang)} aria-current={navCurrent('/horeca', path)}>{t.nav.horeca}</a>
          <a href={localizedPath('/data/', lang)} aria-current={navCurrent('/data', path)}>{t.nav.data}</a>
          <a href={localizedPath('/methodology/', lang)} aria-current={navCurrent('/methodology', path)}>{t.nav.methodology}</a>
        </nav>
        <a class="lang-switch" href={switchLangPath(Astro.url, otherLang)} hreflang={otherLang}>
          {t.langSwitch}
        </a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t.footer}</p>
      <p>{t.license}</p>
    </footer>
  </body>
</html>
